# Every text file is LF in the repository and in the working tree, on every platform. Without
# this, a Windows checkout rewrites text files to CRLF: Prettier then reports all of them, and the
# signed PDF fixtures change bytes, which breaks their PAdES signature and the identity tests.
* text=auto eol=lf

# Exact bytes, never a line-ending or diff filter: one converted byte breaks a signature,
# a certificate or an archive.
*.pdf   binary
*.pem   binary
*.p12   binary
*.der   binary
*.pptx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# Generated by npm; keep it out of diffs and reviews.
package-lock.json -diff linguist-generated
