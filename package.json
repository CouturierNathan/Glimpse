{
  "name": "glimpse",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "lint": "eslint . && solhint --noPrompt \"contracts/**/*.sol\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.4",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
