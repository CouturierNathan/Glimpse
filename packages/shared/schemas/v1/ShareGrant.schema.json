{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/ShareGrant.schema.json",
  "title": "ShareGrant",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "grantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "itemVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "holderId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "recipientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "consentRequestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "revocation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "active"
            }
          },
          "required": ["status"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "revoked"
            },
            "revokedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            }
          },
          "required": ["status", "revokedAt"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "grantId",
    "itemId",
    "itemVersion",
    "holderId",
    "recipientId",
    "consentRequestId",
    "createdAt",
    "expiresAt",
    "revocation"
  ],
  "additionalProperties": false
}
