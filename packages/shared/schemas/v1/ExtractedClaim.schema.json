{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/ExtractedClaim.schema.json",
  "title": "ExtractedClaim",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "claimId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "attribute": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,127}$"
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        }
      ]
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "documentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "const": "A"
                }
              },
              "required": ["class"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "const": "B"
                },
                "signatureVerificationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              },
              "required": ["class", "signatureVerificationId"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "class": {
                  "const": "C"
                },
                "attestationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "issuerId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              },
              "required": ["class", "attestationId", "issuerId"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["documentId", "documentVersion", "provenance"],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schemaVersion",
    "claimId",
    "attribute",
    "value",
    "period",
    "document",
    "pages",
    "confidence"
  ],
  "additionalProperties": false
}
