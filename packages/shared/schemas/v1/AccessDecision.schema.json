{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/AccessDecision.schema.json",
  "title": "AccessDecision",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "outcome": {
      "enum": ["allow", "deny"]
    },
    "holderId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "consentRequestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "recipientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "recipientKeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "itemVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reason": {
      "enum": ["holder-refused", "consent-withdrawn", "request-expired"]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "required": [
    "schemaVersion",
    "outcome",
    "holderId",
    "consentRequestId",
    "recipientId",
    "recipientKeyId",
    "decidedAt",
    "expiresAt"
  ],
  "additionalProperties": false
}
