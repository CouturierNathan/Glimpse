{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/VerificationRequest.schema.json",
  "title": "VerificationRequest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "requester": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "attribute": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,127}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "recipientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "recipientKeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
    },
    "proof": {
      "type": "object",
      "properties": {
        "type": {
          "const": "EIP712"
        },
        "chainId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "signature": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{130}$"
        }
      },
      "required": ["type", "chainId", "signature"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "requester",
    "attribute",
    "purpose",
    "recipientId",
    "recipientKeyId",
    "createdAt",
    "expiresAt",
    "proof"
  ],
  "additionalProperties": false
}
