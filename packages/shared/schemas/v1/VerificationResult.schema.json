{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/VerificationResult.schema.json",
  "title": "VerificationResult",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "attestationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "issuerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "verdict": {
      "enum": ["authentic", "declared", "expired", "revoked", "undetermined"]
    },
    "checks": {
      "type": "object",
      "properties": {
        "signature": {
          "enum": ["pass", "fail", "unknown"]
        },
        "provenance": {
          "enum": ["pass", "fail", "unknown"]
        },
        "integrity": {
          "enum": ["pass", "fail", "unknown"]
        },
        "validity": {
          "enum": ["pass", "fail", "unknown"]
        },
        "revocation": {
          "enum": ["pass", "fail", "unknown"]
        },
        "replay": {
          "enum": ["pass", "fail", "unknown"]
        }
      },
      "required": ["signature", "provenance", "integrity", "validity", "revocation", "replay"],
      "additionalProperties": false
    },
    "issuerTrusted": {
      "type": "boolean"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
    }
  },
  "required": ["schemaVersion", "requestId", "verdict", "checks", "issuerTrusted", "checkedAt"],
  "additionalProperties": false
}
