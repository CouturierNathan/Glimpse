{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/IssuerRegistryEntry.schema.json",
  "title": "IssuerRegistryEntry",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "issuerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "admin": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "signer": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "metadataURI": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(https|ipfs|data):"
    },
    "chainId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "registry": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    }
  },
  "required": [
    "schemaVersion",
    "issuerId",
    "admin",
    "signer",
    "metadataURI",
    "chainId",
    "registry"
  ],
  "additionalProperties": false
}
