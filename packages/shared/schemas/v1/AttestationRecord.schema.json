{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/AttestationRecord.schema.json",
  "title": "AttestationRecord",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "attestationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "issuerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "holder": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "attribute": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,127}$"
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        }
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
    },
    "salt": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "commitment": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "proof": {
      "type": "object",
      "properties": {
        "type": {
          "const": "EIP712"
        },
        "chainId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "verifyingContract": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{130}$"
        }
      },
      "required": ["type", "chainId", "verifyingContract", "signature"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "attestationId",
    "issuerId",
    "holder",
    "attribute",
    "value",
    "issuedAt",
    "expiresAt",
    "salt",
    "commitment",
    "proof"
  ],
  "additionalProperties": false
}
