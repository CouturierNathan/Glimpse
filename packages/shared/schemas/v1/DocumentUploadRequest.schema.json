{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glimpse.example/schemas/v1/DocumentUploadRequest.schema.json",
  "title": "DocumentUploadRequest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "documentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "documentVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": ["synthetic", "education", "employment"]
    },
    "mediaType": {
      "enum": ["application/pdf", "text/plain"]
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]{0,127}$"
      }
    }
  },
  "required": ["schemaVersion", "documentId", "documentVersion", "kind", "mediaType", "attributes"],
  "additionalProperties": false
}
