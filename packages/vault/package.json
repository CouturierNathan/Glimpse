{
  "name": "@glimpse/vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "browser": null,
      "node": {
        "types": "./src/server/index.ts",
        "default": "./src/server/index.ts"
      }
    },
    "./server/testing": {
      "browser": null,
      "node": {
        "types": "./src/server/testing.ts",
        "default": "./src/server/testing.ts"
      }
    }
  },
  "dependencies": {
    "@glimpse/shared": "0.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "npm run typecheck && node --test src/*.test.ts",
    "demo": "node scripts/demo.ts"
  }
}
