# Key that signs session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Private directory on a persistent disk where the encrypted items are written. Defaults to
# apps/web/.vault-data. A host with a read-only filesystem needs a writable path, /tmp/glimpse-vault
# on Vercel, which apps/web/vercel.json already sets.
# VAULT_DATA_DIR=

# PEM bundle of the CAs whose PAdES signatures are accepted (France Identité's CA in production).
# Unset, no signature is trusted. For a local demo only, the FAKE test CA:
# PADES_TRUST_ANCHORS=fixtures/identity/FAKE-test-ca.pem
